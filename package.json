{
  "name": "aftertaste-reader",
  "version": "0.1.0-alpha.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "THIRD-PARTY-NOTICES.md",
    "docs/usage/assets/alpha2-bookmark-loop.png",
    "docs/usage/assets/alpha2-bookmark-source.png",
    "docs/usage/assets/apache-answer-LICENSE.txt",
    "docs/usage/assets/apache-answer-NOTICE.txt",
    "dist/**/*.js",
    "dist/web/index.html",
    "dist/web/assets/",
    "dist/web/third-party-licenses.md",
    "skills/aftertaste-reader/SKILL.md",
    "skills/aftertaste-reader/references/*.md",
    "!skills/aftertaste-reader/references/README.md",
    "skills/aftertaste-reader/assets/templates/*.md",
    "!skills/aftertaste-reader/assets/templates/README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "build": "tsc && node scripts/build-web.mjs",
    "prepack": "npm run build",
    "test:browser": "node tests/browser/file-reader.mjs",
    "test:browser:canvas": "node tests/browser/dependency-canvas.mjs",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs tests/integration/*.test.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/inter": "5.2.8",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue-flow/core": "1.48.2",
    "linguist-languages": "9.5.0",
    "markdown-it": "15.0.3",
    "playwright": "1.65.1",
    "shiki": "4.6.0",
    "tm-grammars": "1.32.22",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vscode-oniguruma": "1.7.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "mdast-util-from-markdown": "2.1.0"
  }
}
