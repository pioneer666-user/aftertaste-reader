{
  "name": "aftertaste-reader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "build": "tsc && vite build",
    "test:browser": "node tests/browser/file-reader.mjs",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs tests/integration/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "@vitejs/plugin-vue": "6.0.11",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14",
    "playwright": "1.65.1"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0",
    "fastify": "5.12.8",
    "vue": "3.5.45",
    "markdown-it": "15.0.3",
    "@fontsource/inter": "5.2.8"
  }
}
